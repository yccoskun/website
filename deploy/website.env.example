# Example runtime env for /etc/website.env (mode 0640, owner root:deploy).
# Copy, fill secrets, install as /etc/website.env, then:
#   sudo systemctl daemon-reload && sudo systemctl restart website
# Loaded by deploy/website.service via EnvironmentFile=-/etc/website.env
# (EnvironmentFile= overrides Environment= for the same key.)

# --- Required in production ---

# Admin login is disabled until both are set.
ADMIN_USERNAME=admin
# bcrypt hash; prefer: go run ./cmd/hashpw (interactive)
# automation: go run ./cmd/hashpw < /path/to/secret (mode 0600); argv rejected
ADMIN_PASSWORD_HASH=$2a$12$REPLACE_WITH_BCRYPT_HASH

# Caddy → Go on loopback: rate limits / session binding key on CF-Connecting-IP.
# Empty = no proxy trust (all clients share RemoteAddr, e.g. 127.0.0.1).
TRUSTED_PROXIES=127.0.0.0/8,::1/128

# Soft session binding (UA + IP prefix hashes). Match unit Environment=SESSION_BINDING=1.
# Omit this key to inherit the unit value; never leave a falsy value in production.
SESSION_BINDING=1

# --- Optional (sensible production defaults; omit if unchanged) ---

# ADDR=127.0.0.1:9000
# DB_PATH=data/website.db
# UPLOADS_DIR=data/uploads
# SITE_URL=https://www.yusufcancoskun.com

# --- Dev-only (do NOT set in production /etc/website.env) ---

# ALLOW_STATIC_DIR=1
# STATIC_DIR=web/dist
