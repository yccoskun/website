# Reference copy of /etc/caddy/Caddyfile on the server.
#
# TLS terminates at Cloudflare; cloudflared forwards tunnel traffic to Caddy
# on loopback :8080, and Caddy proxies to the Go binary on loopback :9000.
# Nothing here listens on a public interface.

{
	auto_https off
	admin off
}

:8080 {
	bind 127.0.0.1

	encode zstd gzip
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	reverse_proxy 127.0.0.1:9000 {
		# Drop spoofable client IP headers. Leave CF-Connecting-IP alone:
		# reverse_proxy passes it through from cloudflared by default. Do not
		# delete-and-readd via header_up placeholders — that can send an empty
		# CF header upstream and Go returns 400 "missing client ip" when
		# TRUSTED_PROXIES trusts loopback.
		header_up -X-Forwarded-For
		header_up -X-Real-IP
	}
}
